/* pages/sample/sample.wxss */

/* ---------- 头部 ---------- */

.head {
  padding: 30rpx 32rpx 36rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #D8D2C6;
}

.head-micro {
  font-size: 17rpx;
  font-weight: 600;
  color: #2F6FB2;
  letter-spacing: 3rpx;
}

.head-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #1F3A44;
  letter-spacing: 1rpx;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #5C666B;
  line-height: 1.7;
}

/* ---------- 流程 ---------- */

.steps {
  margin-top: 28rpx;
  position: relative;
}

.step {
  display: flex;
  align-items: flex-start;
  padding-bottom: 26rpx;
}

.step-last {
  padding-bottom: 0;
}

.step-no {
  width: 56rpx;
  flex: none;
  font-size: 22rpx;
  font-weight: 800;
  color: #E0C99A;
  line-height: 1.6;
}

.step-body {
  flex: 1;
}

.step-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F3A44;
  line-height: 1.6;
}

.step-desc {
  font-size: 22rpx;
  color: #8C979D;
  line-height: 1.5;
}

/* ---------- 表单 ---------- */

.form {
  padding: 4rpx 28rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.field-last {
  padding-bottom: 26rpx;
}

.field-top {
  align-items: flex-start;
}

.field-label {
  width: 168rpx;
  flex: none;
  font-size: 25rpx;
  color: #43535A;
}

.req {
  color: #D9534F;
  margin-left: 4rpx;
}

.field-input {
  flex: 1;
  font-size: 26rpx;
  color: #1F3A44;
  height: 44rpx;
  line-height: 44rpx;
}

.field-textarea {
  flex: 1;
  font-size: 26rpx;
  color: #1F3A44;
  line-height: 1.6;
  min-height: 120rpx;
  width: 100%;
}

.field-ph {
  color: #B2BBC0;
  font-size: 24rpx;
}

/* ---------- 选项块 ---------- */

.block {
  margin-top: 20rpx;
}

.block-label {
  font-size: 25rpx;
  color: #43535A;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.opts {
  display: flex;
  flex-wrap: wrap;
}

.opt {
  padding: 12rpx 22rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  border-radius: 10rpx;
  background: #F4F1EA;
  border: 2rpx solid transparent;
  font-size: 23rpx;
  color: #55646B;
  line-height: 1.4;
}

.opt-on {
  background: #FCF0DA;
  border-color: #F0A22E;
  color: #A56C06;
  font-weight: 600;
}

/* ---------- 提交 ---------- */

.submit-area {
  margin-top: 44rpx;
}

.btn-disabled {
  opacity: 0.55;
}

.submit-note {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: #A0A9AE;
  text-align: center;
}

/* ---------- 完成 ---------- */

.done {
  margin-top: 30rpx;
  padding: 44rpx 32rpx 36rpx;
  text-align: center;
}

.done-badge {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #F0A22E;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.done-title {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1F3A44;
}

.done-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #77817F;
  line-height: 1.7;
}

.done-info {
  margin-top: 30rpx;
  padding: 22rpx 24rpx;
  background: #FBFAF7;
  border-radius: 14rpx;
  text-align: left;
}

.done-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.done-key {
  width: 150rpx;
  flex: none;
  font-size: 22rpx;
  color: #9AA4A9;
}

.done-val {
  flex: 1;
  font-size: 23rpx;
  color: #43535A;
  line-height: 1.5;
}

.done-actions {
  display: flex;
  margin-top: 32rpx;
}

.done-btn {
  flex: 1;
}

.done-btn-left {
  margin-right: 20rpx;
}

.done-back {
  margin-top: 26rpx;
  font-size: 23rpx;
  color: #8C979D;
}

.done-hint {
  margin-top: 24rpx;
  font-size: 20rpx;
  color: #A8B0B4;
  text-align: center;
  line-height: 1.7;
}

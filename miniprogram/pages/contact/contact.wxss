/* pages/contact/contact.wxss */

/* ---------- 头部 ---------- */

.head {
  position: relative;
  padding: 36rpx 32rpx 96rpx;
  background: linear-gradient(158deg, #244754 0%, #1B3540 58%, #102329 100%);
  overflow: hidden;
}

.head-glow {
  position: absolute;
  right: -140rpx;
  top: -160rpx;
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(240, 162, 46, 0.24) 0%, rgba(240, 162, 46, 0) 70%);
}

.head-inner {
  position: relative;
  z-index: 2;
}

.head-micro {
  font-size: 17rpx;
  font-weight: 600;
  color: #F0A22E;
  letter-spacing: 3rpx;
}

.head-title {
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.head-slogan {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 3rpx;
}

.head-slogan-en {
  margin-top: 6rpx;
  font-size: 16rpx;
  color: rgba(240, 162, 46, 0.78);
  letter-spacing: 2.6rpx;
}

.founder {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.founder-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #F0A22E;
  color: #1F3A44;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.founder-body {
  margin-left: 20rpx;
}

.founder-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.founder-en {
  margin-left: 10rpx;
  font-size: 17rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.42);
  letter-spacing: 0.6rpx;
}

.founder-role {
  margin-top: 3rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.52);
  letter-spacing: 1rpx;
}

/* ---------- 联系行 ---------- */

.rows {
  margin-top: -66rpx;
  position: relative;
  padding: 4rpx 28rpx;
}

.row-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.row-hover {
  opacity: 0.7;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-key {
  display: block;
  font-size: 20rpx;
  color: #9AA4A9;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}

.row-val {
  font-size: 27rpx;
  color: #1F3A44;
  font-weight: 500;
  line-height: 1.45;
  word-break: break-all;
}

.row-action {
  flex: none;
  margin-left: 18rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #F4F1EA;
  font-size: 21rpx;
  color: #6E777C;
}

/* ---------- 二维码 ---------- */

.qr {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 26rpx;
}

.qr-img {
  width: 220rpx;
  height: 220rpx;
  flex: none;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 1rpx solid #EDE8DE;
}

.qr-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.qr-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1F3A44;
}

.qr-desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8C979D;
  line-height: 1.6;
}

.qr-actions {
  display: flex;
  margin-top: 16rpx;
}

.qr-btn {
  padding: 0 22rpx;
}

/* ---------- 操作 ---------- */

.actions {
  display: flex;
  margin-top: 30rpx;
}

.actions-btn {
  flex: 1;
}

.actions-left {
  margin-right: 20rpx;
}

.actions-note {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #A0A9AE;
  text-align: center;
}

/* ---------- 报价 ---------- */

.quote {
  margin-top: 32rpx;
  padding: 26rpx 28rpx;
  background: #EDE7DA;
  border-radius: 16rpx;
}

.quote-title {
  font-size: 23rpx;
  font-weight: 700;
  color: #8A7A5C;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.quote-text {
  font-size: 22rpx;
  color: #5E6A6F;
  line-height: 1.75;
  margin-top: 4rpx;
}

/* ---------- 页脚 ---------- */

.footer {
  margin-top: 56rpx;
  padding-top: 30rpx;
  text-align: center;
}

.footer-about {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-bottom: 26rpx;
  border-bottom: 1rpx solid #E7E1D5;
}

.footer-link {
  font-size: 23rpx;
  color: #6E777C;
  margin-right: 8rpx;
}

.footer-slogan {
  font-size: 34rpx;
  font-weight: 800;
  color: #1F3A44;
  letter-spacing: 4rpx;
}

.footer-slogan-en {
  margin-top: 8rpx;
  font-size: 16rpx;
  color: #B3A98F;
  letter-spacing: 2.6rpx;
}

.footer-logo {
  display: block;
  width: 240rpx;
  height: 136rpx;
  margin: 26rpx auto 20rpx;
}

/* pages/products/products.wxss */

/* ---------- 搜索 ---------- */

.search-wrap {
  padding: 24rpx 32rpx 8rpx;
  background: #F4F1EA;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 38rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 68, 0.04);
}

.search-glass {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #B6BFC4;
  border-radius: 50%;
  flex: none;
  margin-right: 16rpx;
  position: relative;
}

.search-glass::after {
  content: '';
  position: absolute;
  right: -7rpx;
  bottom: -6rpx;
  width: 11rpx;
  height: 3rpx;
  background: #B6BFC4;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1F3A44;
  height: 76rpx;
  line-height: 76rpx;
}

.search-ph {
  color: #B2BBC0;
  font-size: 25rpx;
}

.search-clear {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9AA4A9;
  background: #F1EDE4;
  border-radius: 50%;
  margin-left: 10rpx;
}

/* ---------- 筛选 chips ---------- */

.chips {
  width: 100%;
  white-space: nowrap;
}

.chips-inner {
  display: inline-block;
  padding: 14rpx 32rpx 10rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  color: #55646B;
  font-size: 25rpx;
  border: 2rpx solid transparent;
}

.chip-on {
  background: #1F3A44;
  color: #FFFFFF;
  font-weight: 600;
}

.chip-num {
  margin-left: 8rpx;
  font-size: 19rpx;
  opacity: 0.55;
}

/* ---------- 系列说明 ---------- */

.series-desc {
  margin-top: 8rpx;
  padding: 18rpx 24rpx;
  background: #EDE7DA;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: #5E6A6F;
  line-height: 1.6;
}

.count-row {
  display: flex;
  align-items: baseline;
  margin-top: 22rpx;
  margin-bottom: 16rpx;
}

.count {
  font-size: 22rpx;
  color: #8C979D;
  letter-spacing: 0.5rpx;
}

.count-key {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #A56C06;
}

/* ---------- 产品行 ---------- */

.item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.item-hover {
  opacity: 0.75;
}

.item-img-wrap {
  width: 156rpx;
  height: 156rpx;
  flex: none;
  background: #FBFAF7;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-img {
  width: 136rpx;
  height: 136rpx;
}

.item-body {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.item-head {
  display: flex;
  align-items: center;
}

.item-model {
  font-size: 32rpx;
  font-weight: 800;
  color: #1F3A44;
  letter-spacing: 0.5rpx;
  margin-right: 12rpx;
}

.item-name {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #43535A;
}

.item-usage {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8C979D;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-foot {
  display: flex;
  align-items: center;
  min-height: 34rpx;
  margin-top: 10rpx;
}

.item-meta {
  font-size: 19rpx;
  color: #77817F;
  background: #F4F1EA;
  border-radius: 6rpx;
  padding: 3rpx 10rpx;
  margin-right: 8rpx;
}

.item-pack {
  margin-left: auto;
  font-size: 19rpx;
  color: #A56C06;
  flex: none;
}

.item-arrow {
  margin-left: 12rpx;
}

/* ---------- 空状态 ---------- */

.empty-title {
  font-size: 28rpx;
  color: #43535A;
  font-weight: 600;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9AA4A9;
}

.empty-actions {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}

.empty-btn {
  margin-left: 16rpx;
}

/* ---------- 底部提示 ---------- */

.tip {
  margin-top: 12rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #244754 0%, #16303A 100%);
}

.tip-main {
  font-size: 27rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.tip-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.cell-hover {
  opacity: 0.75;
}

/* pages/selector/selector.wxss */

/* ---------- 头部 ---------- */

.head {
  padding: 30rpx 32rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #D8D2C6;
}

.head-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1F3A44;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #5C666B;
  line-height: 1.7;
}

/* ---------- 步骤条 ---------- */

.stepper {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.stepper-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  flex: none;
}

.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #D8D2C6;
  color: #A8A08E;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.dot-on {
  background: #F0A22E;
  border-color: #F0A22E;
  color: #1F3A44;
}

.dot-label {
  margin-top: 10rpx;
  font-size: 19rpx;
  color: #9AA4A9;
  white-space: nowrap;
}

.dot-label-on {
  color: #A56C06;
  font-weight: 600;
}

.line {
  flex: 1;
  height: 2rpx;
  background: #E7E1D5;
  margin-bottom: 34rpx;
}

.line-on {
  background: #F0A22E;
}

/* ---------- 步骤标题 ---------- */

.step-title {
  margin-top: 36rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F3A44;
  line-height: 1.45;
}

.step-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #77817F;
  line-height: 1.65;
}

/* ---------- 工况网格 ---------- */

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
}

.cell {
  width: calc((100% - 20rpx) / 2);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 22rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 58, 68, 0.04);
  min-height: 156rpx;
}

.cell:nth-child(2n) {
  margin-right: 0;
}

.cell-hover {
  opacity: 0.7;
}

.cell-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F3A44;
  line-height: 1.45;
}

.cell-en {
  margin-top: 4rpx;
  font-size: 16rpx;
  font-weight: 600;
  color: #B3A98F;
  letter-spacing: 0.6rpx;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cell-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #8C979D;
  line-height: 1.5;
}

/* ---------- 涂胶方式 ---------- */

.method {
  margin-top: 22rpx;
  padding: 28rpx;
}

.method-head {
  display: flex;
  align-items: baseline;
}

.method-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F3A44;
}

.method-en {
  margin-left: 12rpx;
  font-size: 17rpx;
  font-weight: 600;
  color: #B3A98F;
  letter-spacing: 0.6rpx;
  text-transform: uppercase;
}

.method-rows {
  margin-top: 16rpx;
}

.method-row {
  display: flex;
  align-items: flex-start;
  padding: 9rpx 0;
}

.method-key {
  width: 170rpx;
  flex: none;
  font-size: 22rpx;
  color: #9AA4A9;
}

.method-val {
  flex: 1;
  font-size: 23rpx;
  color: #43535A;
  line-height: 1.5;
}

.back-link {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #8C979D;
  text-align: center;
}

/* ---------- 结果：摘要 ---------- */

.summary {
  display: flex;
  margin-top: 30rpx;
}

.summary-item {
  flex: 1;
  padding: 18rpx 22rpx;
  background: #EDE7DA;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.summary-item:last-child {
  margin-right: 0;
}

.summary-key {
  display: block;
  font-size: 18rpx;
  color: #9A8E75;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}

.summary-val {
  font-size: 23rpx;
  font-weight: 600;
  color: #1F3A44;
  line-height: 1.4;
}

/* ---------- 结果：推荐卡 ---------- */

.rec {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 2rpx solid #F3E3C4;
}

.rec-label {
  font-size: 19rpx;
  font-weight: 700;
  color: #A56C06;
  letter-spacing: 2rpx;
}

.rec-main {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.rec-img-wrap {
  width: 168rpx;
  height: 168rpx;
  flex: none;
  background: #FBFAF7;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rec-img {
  width: 148rpx;
  height: 148rpx;
}

.rec-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.rec-model {
  font-size: 42rpx;
  font-weight: 800;
  color: #1F3A44;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.rec-name {
  margin-top: 2rpx;
  font-size: 25rpx;
  color: #43535A;
}

.rec-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.rec-chips .tag {
  margin-right: 10rpx;
}

.rec-reason {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3EBDC;
  font-size: 24rpx;
  color: #43535A;
  line-height: 1.7;
}

.rec-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8C979D;
  line-height: 1.6;
}

/* ---------- 结果：备选 ---------- */

.alt-title {
  margin-top: 34rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #77817F;
  letter-spacing: 1rpx;
}

.alt-list {
  margin-top: 14rpx;
  padding: 4rpx 24rpx;
}

.alt-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1ECE2;
}

.alt-row:last-child {
  border-bottom: none;
}

.alt-img {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  background: #FBFAF7;
  border-radius: 12rpx;
}

.alt-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.alt-model {
  font-size: 27rpx;
  font-weight: 700;
  color: #1F3A44;
}

.alt-usage {
  margin-top: 3rpx;
  font-size: 21rpx;
  color: #8C979D;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alt-pack {
  flex: none;
  font-size: 20rpx;
  color: #A56C06;
  margin-left: 12rpx;
}

/* ---------- 施胶建议 ---------- */

.advice {
  margin-top: 30rpx;
}

.advice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F3A44;
  margin-bottom: 14rpx;
}

.advice-row {
  display: flex;
  align-items: flex-start;
  padding: 7rpx 0;
}

.advice-key {
  width: 120rpx;
  flex: none;
  font-size: 22rpx;
  color: #9AA4A9;
}

.advice-val {
  flex: 1;
  font-size: 23rpx;
  color: #43535A;
}

.advice-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #F4F1EA;
  border-radius: 10rpx;
  font-size: 21rpx;
  color: #6E777C;
  line-height: 1.6;
}

/* ---------- 验收 ---------- */

.accept {
  margin-top: 20rpx;
}

.accept-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F3A44;
  margin-bottom: 12rpx;
}

.accept-text {
  font-size: 23rpx;
  color: #55646B;
  line-height: 1.7;
  margin-top: 6rpx;
}

/* ---------- 操作 ---------- */

.actions {
  display: flex;
  margin-top: 36rpx;
}

.actions-btn {
  flex: 1;
}

.actions-left {
  margin-right: 20rpx;
}

.disclaimer {
  margin-top: 24rpx;
  font-size: 20rpx;
  color: #A8B0B4;
  line-height: 1.7;
  text-align: center;
}

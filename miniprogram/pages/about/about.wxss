/* pages/about/about.wxss */

/* ---------- 头部 ---------- */

.head {
  padding: 36rpx 32rpx 88rpx;
  background: linear-gradient(158deg, #244754 0%, #1B3540 60%, #102329 100%);
}

.head-micro {
  font-size: 17rpx;
  font-weight: 600;
  color: #F0A22E;
  letter-spacing: 3rpx;
}

.head-title {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.75;
}

/* ---------- 简介 ---------- */

.intro {
  margin-top: -60rpx;
  position: relative;
}

.intro-head {
  margin-bottom: 18rpx;
}

.about-logo {
  display: block;
  width: 300rpx;
  height: 170rpx;
  margin-bottom: 24rpx;
}

.para {
  font-size: 25rpx;
  color: #43535A;
  line-height: 1.85;
  margin-bottom: 14rpx;
}

.photo-row {
  display: flex;
  margin-top: 20rpx;
}

.photo {
  flex: 1;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  background: #F1EDE4;
}

.photo:last-child {
  margin-right: 0;
}

.photo-note {
  margin-top: 12rpx;
  font-size: 19rpx;
  color: #A8B0B4;
  letter-spacing: 0.5rpx;
}

/* ---------- 数据 ---------- */

.stats {
  display: flex;
  margin-top: 20rpx;
  padding: 30rpx 6rpx;
}

.stat {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat + .stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: #EDE8DE;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
  color: #1F3A44;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.stat-unit {
  font-size: 19rpx;
  font-weight: 600;
  color: #A7B0B5;
  margin-left: 2rpx;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8C979D;
}

.stat-en {
  margin-top: 2rpx;
  font-size: 16rpx;
  color: #BFC6C9;
  letter-spacing: 0.4rpx;
}

/* ---------- 时间轴 ---------- */

.timeline {
  padding-top: 12rpx;
}

.tl-item {
  display: flex;
}

.tl-last .tl-body {
  padding-bottom: 0;
}

.tl-left {
  width: 76rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 52rpx;
  height: 52rpx;
  flex: none;
  border-radius: 50%;
  background: #1F3A44;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: #E7E1D5;
  margin: 8rpx 0;
}

.tl-body {
  flex: 1;
  padding: 6rpx 0 34rpx 12rpx;
}

.tl-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1F3A44;
  line-height: 1.4;
}

.tl-en {
  font-size: 17rpx;
  color: #B3A98F;
  letter-spacing: 0.6rpx;
  text-transform: uppercase;
  margin-top: 2rpx;
}

.tl-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #77817F;
  line-height: 1.6;
}

/* ---------- 说明文字 ---------- */

.note {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8C979D;
  line-height: 1.75;
}

/* ---------- 资质 ---------- */

.cert-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.cert-cell {
  width: calc((100% - 20rpx) / 2);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  padding: 22rpx;
}

.cert-cell:nth-child(2n) {
  margin-right: 0;
}

.cell-hover {
  opacity: 0.7;
}

.cert-img {
  width: 100%;
  height: 210rpx;
  background: #FBFAF7;
  border-radius: 10rpx;
}

.cert-title {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1F3A44;
}

.cert-en {
  margin-top: 2rpx;
  font-size: 16rpx;
  color: #B3A98F;
  letter-spacing: 0.5rpx;
  text-transform: uppercase;
}

.cert-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9AA4A9;
  line-height: 1.5;
}

/* ---------- 专利 ---------- */

.patent {
  padding-top: 10rpx;
}

.patent-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F1ECE2;
}

.patent-item:last-child {
  border-bottom: none;
}

.patent-no {
  width: 48rpx;
  flex: none;
  font-size: 21rpx;
  font-weight: 700;
  color: #E0C99A;
}

.patent-text {
  flex: 1;
  font-size: 24rpx;
  color: #43535A;
  line-height: 1.6;
}

/* ---------- 案例 ---------- */

.case {
  margin-bottom: 22rpx;
  overflow: hidden;
}

.case-img {
  width: 100%;
  height: 300rpx;
  background: #F1EDE4;
  display: block;
}

.case-body {
  padding: 24rpx 26rpx 28rpx;
}

.case-loc {
  display: inline-block;
  font-size: 18rpx;
  color: #A56C06;
  background: #FCF0DA;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  letter-spacing: 0.5rpx;
}

.case-title {
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #1F3A44;
  line-height: 1.5;
}

.case-en {
  margin-top: 3rpx;
  font-size: 18rpx;
  color: #B3A98F;
  letter-spacing: 0.4rpx;
}

.case-detail {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #6E777C;
  line-height: 1.7;
}

/* ---------- 政策 ---------- */

.policy {
  padding: 8rpx 28rpx;
}

.policy-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1ECE2;
}

.policy-item:last-child {
  border-bottom: none;
}

.policy-no {
  width: 52rpx;
  flex: none;
  font-size: 21rpx;
  font-weight: 800;
  color: #E0C99A;
  line-height: 1.6;
}

.policy-body {
  flex: 1;
}

.policy-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #1F3A44;
  line-height: 1.55;
}

.policy-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #77817F;
  line-height: 1.65;
}

.voc {
  margin-top: 20rpx;
}

.voc-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F3A44;
  margin-bottom: 16rpx;
}

.voc-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.voc-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #F0A22E;
  flex: none;
  margin-top: 15rpx;
  margin-right: 16rpx;
}

.voc-body {
  flex: 1;
}

.voc-name {
  font-size: 23rpx;
  font-weight: 600;
  color: #43535A;
  line-height: 1.55;
}

.voc-desc {
  margin-top: 3rpx;
  font-size: 21rpx;
  color: #8C979D;
  line-height: 1.6;
}

.policy-note {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  background: #EDE7DA;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #5E6A6F;
  line-height: 1.75;
}

.disclaimer {
  margin-top: 14rpx;
  font-size: 19rpx;
  color: #A8B0B4;
  line-height: 1.7;
}

/* ---------- 定制 ---------- */

.custom {
  padding: 8rpx 28rpx;
}

.custom-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1ECE2;
}

.custom-item:last-child {
  border-bottom: none;
}

.custom-head {
  display: flex;
  align-items: baseline;
}

.custom-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1F3A44;
}

.custom-en {
  margin-left: 12rpx;
  font-size: 17rpx;
  color: #B3A98F;
  letter-spacing: 0.5rpx;
  text-transform: uppercase;
}

.custom-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6E777C;
  line-height: 1.7;
}

/* ---------- 底部操作 ---------- */

.actions {
  display: flex;
  margin-top: 44rpx;
}

.actions-btn {
  flex: 1;
}

.actions-left {
  margin-right: 20rpx;
}
